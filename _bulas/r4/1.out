[{"productId":"919250","productName":"Analgésico Aspmol 750mg 20 Comprimido","brand":"Aspmol","brandId":8709,"brandImageUrl":null,"linkText":"analgesico-aspmol-750mg-20-comprimido","productReference":"919250","productReferenceCode":"919250","categoryId":"868","productTitle":"Analgésico Aspmol 750mg 20 Comprimido","metaTagDescription":"Compre Analgésico Aspmol 750mg 20 Comprimido nas Drogarias Pacheco | Entrega Rápida e Segura | Parcele em até 3x sem juros.","releaseDate":"2026-05-07T00:00:00Z","clusterHighlights":{},"productClusters":{"4422":"tudo-menos-medicamentos-2020","4437":"todos-medicamentos","6059":"Cupom Progressivo","6406":"Vitrine Johnson & Johnson - 16/03","24199":"72 horas de Ofertas","24232":"Comemoração em Dobro","24390":"Festa esta acabando: Itens imperdíveis até 75%","24487":"Campanha 72 horas","24489":"Campanha Leve Mais Por Menos"},"searchableClusters":{},"categories":["/Remédios/"],"categoriesIds":["/868/"],"link":"https://www.drogariaspacheco.com.br/analgesico-aspmol-750mg-20-comprimido/p","Valor Promocional":["6.86"],"Campos para Renderização de Informações Dinâmicas":["Valor Promocional"],"allSpecifications":["Valor Promocional"],"allSpecificationsGroups":["Campos para Renderização de Informações Dinâmicas"],"description":"Aspmol 750mg comprimido — alívio de dores e febre no dia a dia\n\nAquele dia em que a dor de cabeça aparece do nada, a febre resolve dar as caras ou a cólica menstrual atrapalha tudo — nesses momentos, contar com um analgésico de confiança faz toda a diferença. O Aspmol 750mg é um medicamento à base de paracetamol, indicado para o alívio temporário de dores leves a moderadas e para a redução da febre, sendo uma opção prática para o uso no cotidiano.\n\nFabricado pela Bayer, o Aspmol 750mg é apresentado em embalagem com 20 comprimidos.\n\nPara que serve\n\nO Aspmol 750mg é indicado para o alívio temporário de:\nDor de cabeça\nDor no corpo\nDores musculares\nDor nas costas\nDor de dente\nDor de garganta\nCólica menstrual\nDores leves associadas a artrites\nDores associadas a gripes e resfriados comuns\nRedução da febre\n\n\nComo funciona\n\nO princípio ativo do Aspmol é o paracetamol, um dos analgésicos e antipiréticos mais utilizados no mundo. Ele age no sistema nervoso central, reduzindo a percepção da dor e auxiliando na diminuição da temperatura corporal elevada.\n\nModo de uso\nA dose recomendada para adultos é de 1 comprimido de 750mg por vez\nO intervalo entre as doses deve ser de pelo menos 4 a 6 horas\nNão ultrapassar a dose máxima diária indicada na bula\nPode ser tomado com ou sem alimentos\nEngolir o comprimido inteiro com um copo de água\n\n\nSiga sempre as orientações do profissional de saúde ou as instruções da bula.\n\nPrecauções\nNão utilize este medicamento se tiver hipersensibilidade ao paracetamol ou a qualquer outro componente da fórmula\nNão use em casos de insuficiência hepática grave\nNão utilize junto com outros produtos que também contenham paracetamol, para evitar superdosagem\nEvite o consumo de bebidas alcoólicas durante o tratamento\nConsulte um médico antes de usar em casos de doenças hepáticas, renais ou durante a gestação e amamentação\n\n\nComposição\n\nCada comprimido contém 750mg de paracetamol como princípio ativo, além de excipientes descritos na bula do produto.\n\nInformações adicionais\nMarca: Aspmol\nFabricante: Bayer\nPrincípio ativo: Paracetamol 750mg\nApresentação: Caixa com 20 comprimidos\nTipo de medicamento: Analgésico e antipirético\nMedicamento notificado conforme RDC nº 576/2021\nSAC: 0800 723 1010 | sacbayerch@bayer.com\n\n\nEste medicamento deve ser utilizado conforme orientação médica.\nEm caso de dúvidas, consulte o profissional de saúde.\nLeia atentamente a bula antes de iniciar o uso.\nSE PERSISTIREM OS SINTOMAS, O MÉDICO DEVERÁ SER CONSULTADO.","items":[{"itemId":"919250","name":"Analgésico Aspmol 750mg 20 Comprimido","nameComplete":"Analgésico Aspmol 750mg 20 Comprimido","complementName":"Analgésico Aspmol 750mg 20 Comprimido","ean":"7891106916738","referenceId":[{"Key":"RefId","Value":"919250"}],"measurementUnit":"un","unitMultiplier":1.0000,"modalType":"GLASS","isKit":false,"images":[{"imageId":"2570128","imageLabel":"","imageTag":"<img src=\"~/arquivos/ids/2570128-#width#-#height#/919250--Analgesico-Aspmol-750mg-20-Comprimido-1.jpg?v=639245684687070000\" width=\"#width#\" height=\"#height#\" alt=\"919250--Analgesico-Aspmol-750mg-20-Comprimido-1\" id=\"\" />","imageUrl":"https://drogariaspacheco.vteximg.com.br/arquivos/ids/2570128/919250--Analgesico-Aspmol-750mg-20-Comprimido-1.jpg?v=639245684687070000","imageText":"919250--Analgesico-Aspmol-750mg-20-Comprimido-1","imageLastModified":"2026-09-09T16:34:28.7070000Z"},{"imageId":"2570129","imageLabel":"","imageTag":"<img src=\"~/arquivos/ids/2570129-#width#-#height#/919250--Analgesico-Aspmol-750mg-20-Comprimido-2.jpg?v=639245684687200000\" width=\"#width#\" height=\"#height#\" alt=\"919250--Analgesico-Aspmol-750mg-20-Comprimido-2\" id=\"\" />","imageUrl":"https://drogariaspacheco.vteximg.com.br/arquivos/ids/2570129/919250--Analgesico-Aspmol-750mg-20-Comprimido-2.jpg?v=639245684687200000","imageText":"919250--Analgesico-Aspmol-750mg-20-Comprimido-2","imageLastModified":"2026-09-09T16:34:28.7200000Z"},{"imageId":"2570130","imageLabel":"","imageTag":"<img src=\"~/arquivos/ids/2570130-#width#-#height#/919250--Analgesico-Aspmol-750mg-20-Comprimido-3.jpg?v=639245684687370000\" width=\"#width#\" height=\"#height#\" alt=\"919250--Analgesico-Aspmol-750mg-20-Comprimido-3\" id=\"\" />","imageUrl":"https://drogariaspacheco.vteximg.com.br/arquivos/ids/2570130/919250--Analgesico-Aspmol-750mg-20-Comprimido-3.jpg?v=639245684687370000","imageText":"919250--Analgesico-Aspmol-750mg-20-Comprimido-3","imageLastModified":"2026-09-09T16:34:28.7370000Z"}],"sellers":[{"sellerId":"1","sellerName":"Drogarias Pacheco","addToCartLink":"https://www.drogariaspacheco.com.br/checkout/cart/add?sku=919250&qty=1&seller=1&sc=1&price=945&cv=_&sc=1","sellerDefault":true,"commerti