[{"productId":"177967","productName":"Aspmol 750mg 20 Comprimidos","brand":"Aspmol","brandId":2002692,"brandImageUrl":null,"linkText":"aspmol-750mg-20-comprimidos","productReference":"81926","productReferenceCode":"81926","categoryId":"108","productTitle":"Aspmol 750mg 20 Comprimidos","metaTagDescription":"Aspmol 750mg com paracetamol ajuda a reduzir febre e aliviar dores leves a moderadas como dor de cabeça e dor no corpo. Compre na Pague Menos!","releaseDate":"2026-01-29T00:00:00Z","clusterHighlights":{},"productClusters":{"200":"Todos","1000":"XML de Todo o Site","2814":"Bayer Ofertas","3150":"Medicamentos CMS","3394":"Produtos que você precisa ter em casa","3744":"Todos os Produtos - Menos GLP1","4110":"[TODOS CC1 = 5X MIN=40, CC2 = 10X MIN=40, CC6 = 6X MIN=40]"},"searchableClusters":{},"categories":["/Medicamentos e Saúde/Dor, Febre e inflamação/","/Medicamentos e Saúde/"],"categoriesIds":["/100/108/","/100/"],"link":"https://www.paguemenos.com.br/aspmol-750mg-20-comprimidos/p","Medicamento":["True"],"MarcaPropria":["Não"],"NumeroRegistroMS":["ISENTO"],"Ame":["Não"],"ApresentarPrecoDePor":["Sim"],"custom_label_0":["campanha"],"Cashback":["Não"],"Campos de Produto":["Medicamento","MarcaPropria","NumeroRegistroMS","Ame","ApresentarPrecoDePor","custom_label_0","Cashback"],"allSpecifications":["Medicamento","MarcaPropria","NumeroRegistroMS","Ame","ApresentarPrecoDePor","custom_label_0","Cashback"],"allSpecificationsGroups":["Campos de Produto"],"description":"<h2>O que é o Aspmol 750mg 20 Comprimidos?</h2><p><strong>O Aspmol 750mg 20 comprimidos</strong> é um <strong>medicamento analgésico e antitérmico</strong> indicado para <strong>redução da febre</strong> e para o <strong>alívio temporário de dores leves a moderadas</strong>.</p><p>Ele contém <a href=\"/medicamentos-e-saude/medicamentos--a-a-z-\">paracetamol 750mg,</a> substância utilizada para auxiliar em sintomas como <a href=\"/medicamentos-e-saude/dor-febre-e-inflamacao\">dor de cabeça, dor no corpo</a> e dores associadas a <a href=\"/medicamentos-e-saude/gripes-e-resfriados\"><strong>gripes e resfriados.</strong></a></p><p><strong>Conteúdo da embalagem:</strong> 20 comprimidos de <strong>750mg</strong>.</p><p><strong>Fabricado por:</strong> <a href=\"/bayer\">Bayer</a></p><p><strong>Indicação etária:</strong> Uso adulto e pediátrico acima de 12 anos.</p><h2>Composição do Aspmol 750mg 20 Comprimidos:</h2><p><strong>Princípio ativo:</strong> <a href=\"/paracetamol\">paracetamol</a> 750mg.</p><p><strong>Excipientes:</strong> não informado.</p><h2>Para que serve o Aspmol 750mg 20 Comprimidos?</h2><p>O <strong>Aspmol 750mg</strong> é indicado para:</p><ul><li><strong>Redução da febre</strong></li><li><strong>Alívio temporário de dores leves a moderadas</strong>, como dores associadas a gripes e resfriados, dor de cabeça, dor no corpo, dor de dente, dor nas costas, dores musculares, dores leves associadas a artrites, dor de garganta e cólica menstrual</li></ul><h2>Como devo tomar o Aspmol 750mg 20 Comprimidos?</h2><ul><li><strong>Uso oral</strong>, administrar com líquido</li><li>Respeitar a dose diária total de paracetamol de até <strong>4000mg em 24 horas</strong></li><li><strong>Não exceder </strong><strong>1000mg por dose</strong></li><li><strong>Manter intervalos de </strong><strong>4 a 6 horas</strong> entre as doses</li></ul><h2>Quando não devo tomar o Aspmol 750mg 20 Comprimidos?</h2><ul><li><strong>Alergia ao paracetamol</strong> ou a componentes da fórmula</li><li><strong>Insuficiência hepática grave</strong> (Child-Pugh > 9)</li><li>Não utilizar com <strong>outros produtos que contenham paracetamol</strong></li><li><strong>Evitar </strong><strong>bebidas alcoólicas</strong> durante o uso</li></ul>","items":[{"itemId":"1635454","name":"Aspmol 750mg 20 Comprimidos","nameComplete":"Aspmol 750mg 20 Comprimidos","complementName":"","ean":"7891106916738","referenceId":[{"Key":"RefId","Value":"81926"}],"measurementUnit":"un","unitMultiplier":1.0000,"modalType":null,"isKit":false,"images":[{"imageId":"1145770","imageLabel":"","imageTag":"<img src=\"~/arquivos/ids/1145770-#width#-#height#/7891106916738_01.png?v=639094562371900000\" width=\"#width#\" height=\"#height#\" alt=\"7891106916738_01\" id=\"\" />","imageUrl":"https://paguemenos.vteximg.com.br/arquivos/ids/1145770/7891106916738_01.png?v=639094562371900000","imageText":"7891106916738_01","imageLastModified":"2026-03-18T18:43:57.1900000Z"},{"imageId":"1145771","imageLabel":"","imageTag":"<img src=\"~/arquivos/ids/1145771-#width#-#height#/7891106916738_02.png?v=639094562371900000\" width=\"#width#\" height=\"#height#\" alt=\"7891106916738_02\" id=\"\" />","imageUrl":"https://paguemenos.vteximg.com.br/arquivos/ids/1145771/7891106916738_02.png?v=639094562371900000","imageText":"7891106916738_02","imageLastModified":"2026-03-18T18:43:57.1900000Z"},{"imageId":"1145772","imageLabel":"","imageTag":"<img src=\"~/arquivos/ids/1145772-#width#-#height#/7891106916738_03.png?v=639094562372030000\" width=\"#width#\" height=\"#height#\" alt=\"7891106916738_03\" id=\"\" />","imageUrl":"https://paguemenos.vteximg.com.br/arquivos/ids/1145772/7891106916738_03.png?v=639094562372030000","imageText":"7891106916738_03","imageLastModified":"2026-03-18T18:43:57.2030000Z"},{"imageId":"1145773","imageLabel":"","imageTag":"<img src=\"~/arquivos/ids/1145773-#width#-#height#/7891106916738_04.png?v=639094562372030000\" width=\"#width#\" height=\"#height#\" alt=\"7891106916738_04\" id=\"\" />","imageUrl":"https://paguemenos.vteximg.com.br/arquivos/ids/1145773/7891106916738_04.png?v=639094562372030000","imageText":"7891106916738_04","imageLastModified":"2026-03-18T18:43:57.2030000Z"}],"sellers":[{"sellerId":"1","sellerName":"Farmácias Pague Menos","addToCartLink":"https://www.paguemenos.com.br/checkout/cart/add?sku=1635454&qty=1&seller=1&sc=1&price=990&cv=_&sc=1","sellerDefault":true,"commertialOffer":{"DeliverySlaSamplesPerRegion":{"0":{"DeliverySlaPerTypes":[],"Region":null}},"Installments":[{"Value":9.9,"I