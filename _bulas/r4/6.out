on":null,"requiresAuthentication":false,"dueDate":"2026-10-06T16:00:00Z","availablePayments":null}],"payments":[],"giftCards":[],"giftCardMessages":[],"availableAccounts":[],"availableTokens":[]}}}],"Videos":[],"estimatedDateArrival":"2017-02-20T00:00:00Z"}]},{"productId":"174541","productName":"Dipirona AspDip 500mg 30 Comprimidos","brand":"Aspirina","brandId":16899,"brandImageUrl":null,"linkText":"aspdip-500mg-30-comprimidos","productReference":"80966","productReferenceCode":"80966","categoryId":"108","productTitle":"Aspdip 500mg 30 Comprimidos","metaTagDescription":"Aspdip 500mg 30 comprimidos alivia dores e febre com ação rápida da dipirona. Indicado para adultos e adolescentes. Compre na Pague Menos!","releaseDate":"2025-10-09T00:00:00Z","clusterHighlights":{},"productClusters":{"200":"Todos","1000":"XML de Todo o Site","2814":"Bayer Ofertas","3150":"Medicamentos CMS","3394":"Produtos que você precisa ter em casa","3744":"Todos os Produtos - Menos GLP1","4110":"[TODOS CC1 = 5X MIN=40, CC2 = 10X MIN=40, CC6 = 6X MIN=40]"},"searchableClusters":{},"categories":["/Medicamentos e Saúde/Dor, Febre e inflamação/","/Medicamentos e Saúde/"],"categoriesIds":["/100/108/","/100/"],"link":"https://www.paguemenos.com.br/aspdip-500mg-30-comprimidos/p","Medicamento":["True"],"MarcaPropria":["Não"],"NumeroRegistroMS":["1705601310226"],"Ame":["Não"],"ApresentarPrecoDePor":["Sim"],"custom_label_0":["campanha"],"Cashback":["Não"],"Campos de Produto":["Medicamento","MarcaPropria","NumeroRegistroMS","Ame","ApresentarPrecoDePor","custom_label_0","Cashback"],"allSpecifications":["Medicamento","MarcaPropria","NumeroRegistroMS","Ame","ApresentarPrecoDePor","custom_label_0","Cashback"],"allSpecificationsGroups":["Campos de Produto"],"description":"<h2>O que é Aspdip 500mg 30 comprimidos?</h2><p><strong>Aspdip 500mg 30 comprimidos</strong> é um medicamento analgésico e antipirético à base de <strong>dipirona monoidratada</strong>, indicado para o <strong>alívio de dores e febre</strong>. Atua reduzindo a sensação de dor e controlando o aumento da temperatura corporal, proporcionando conforto e bem-estar em situações de desconforto leve a moderado. É indicado para adultos e adolescentes acima de 15 anos.</p><p><strong>Conteúdo da embalagem:</strong> 30 comprimidos</p><p><strong>Fabricado por:</strong> <a href=\"/bayer\">Bayer</a></p><p><strong>Indicação etária:</strong> Uso adulto e adolescentes acima de 15 anos</p><h2>Composição Aspdip 500mg:</h2><p><strong>Princípio ativo:</strong> <a href=\"/dipirona\">Dipirona monoidratada</a> 500mg</p><p><strong>Excipientes:</strong> celulose microcristalina, amido, povidona, estearato de magnésio e outros componentes inativos.</p><h2>Para que serve Aspdip?</h2><ul><li><strong>Redução da febre</strong> (ação antipirética)</li><li><strong>Alívio de dores leves a moderadas</strong>, como dor de cabeça, cólicas, dores musculares e dor de dente</li><li>Pode ser utilizado para <strong>desconfortos associados a gripes e resfriados</strong></li></ul><h2>Como devo tomar Aspdip 500mg?</h2><ul><li><strong>Adultos e adolescentes acima de 15 anos:</strong> ingerir 1 a 2 comprimidos até 4 vezes ao dia, de acordo com a orientação médica</li><li>Tomar com um copo de água, preferencialmente após as refeições</li><li>O uso deve ser apenas pelo período indicado pelo profissional de saúde</li><li>Não exceder a dose recomendada na embalagem</li></ul><h2>Quando não devo tomar Aspdip?</h2><ul><li>Em caso de <strong>alergia à dipirona</strong> ou a outras pirazolonas/pirazolidinas</li><li>Se houver histórico de <strong>reações alérgicas graves</strong> após o uso de medicamentos analgésicos</li><li><strong>Doenças hematológicas</strong> ou comprometimento da função da medula óssea</li><li><strong>Porfiria hepática aguda intermitente</strong> ou <strong>deficiência de G6PD</strong></li><li><strong>Durante a </strong><strong>gravidez e amamentação</strong></li><li><strong>Não indicado para </strong><strong>crianças menores de 15 anos</strong></li></ul>","items":[{"itemId":"179850","name":"Dipirona AspDip 500mg 30 Comprimidos","nameComplete":"Dipirona AspDip 500mg 30 Comprimidos","complementName":"","ean":"7891106916660","referenceId":[{"Key":"RefId","Value":"80966"}],"measurementUnit":"un","unitMultiplier":1.0000,"modalType":null,"isKit":false,"images":[{"imageId":"1157805","imageLabel":"","imageTag":"<img src=\"~/arquivos/ids/1157805-#width#-#height#/7891106916660-Dipirona_AspDip_500mg_30_Comprimidos-Analg_sico-Aspirina--1-.jpg?v=639105034177500000\" width=\"#width#\" height=\"#height#\" alt=\"7891106916660-Dipirona_AspDip_500mg_30_Comprimidos-Analg_sico-Aspirina--1-\" id=\"\" />","imageUrl":"https://paguemenos.vteximg.com.br/arquivos/ids/1157805/7891106916660-Dipirona_AspDip_500mg_30_Comprimidos-Analg_sico-Aspirina--1-.jpg?v=639105034177500000","imageText":"7891106916660-Dipirona_AspDip_500mg_30_Comprimidos-Analg_sico-Aspirina--1-","imageLastModified":"2026-03-30T21:36:57.7500000Z"},{"imageId":"1157806","imageLabel":"","imageTag":"<img src=\"~/arquivos/ids/1157806-#width#-#height#/7891106916660-Dipirona_AspDip_500mg_30_Comprimidos-Analg_sico-Aspirina--2-.jpg?v=639105034177670000\" width=\"#width#\" height=\"#height#\" alt=\"7891106916660-Dipirona_AspDip_500mg_30_Comprimidos-Analg_sico-Aspirina--2-\" id=\"\" />","imageUrl":"https://paguemenos.vteximg.com.br/arquivos/ids/1157806/7891106916660-Dipirona_AspDip_500mg_30_Comprimidos-Analg_sico-Aspirina--2-.jpg?v=639105034177670000","imageText":"7891106916660-Dipirona_AspDip_500mg_30_Comprimidos-Analg_sico-Aspirina--2-","imageLastModified":"2026-03-30T21:36:57.7670000Z"},{"imageId":"1157807","imageLabel":"","imageTag":"<img src=\"~/arquivos/ids/1157807-#width#-#height#/7891106916660-Dipirona_AspDip_500mg_30_Comprimidos-Analg_sico-Aspirina--3-.jpg?v=639105034177830000\" width=\"#width#\" height=\"#height#\" alt=\"7891106916660-Dipirona_AspDip_500mg_30_Comprimidos-Analg_sico-Aspirina--3-\" id=\"\" />","imageUrl":"https://paguemenos.vteximg.com.br/arquivo