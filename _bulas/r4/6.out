ueDate":"2026-10-15T18:00:00Z","availablePayments":null},{"id":169,"name":"Google Pay","groupName":"Google PayPaymentGroup","validator":null,"stringId":"169","template":"Google PayPaymentGroup-template","requiresDocument":false,"isCustom":false,"description":null,"requiresAuthentication":false,"dueDate":"2026-10-15T18:00:00Z","availablePayments":null},{"id":69,"name":"Apple Pay","groupName":"ApplePayPaymentGroup","validator":null,"stringId":"69","template":"ApplePayPaymentGroup-template","requiresDocument":false,"isCustom":false,"description":null,"requiresAuthentication":false,"dueDate":"2026-10-15T18:00:00Z","availablePayments":null},{"id":16,"name":"Vale","groupName":"giftCardPaymentGroup","validator":null,"stringId":"16","template":"giftCardPaymentGroup-template","requiresDocument":false,"isCustom":false,"description":null,"requiresAuthentication":false,"dueDate":"2026-10-15T18:00:00Z","availablePayments":null}],"payments":[],"giftCards":[],"giftCardMessages":[],"availableAccounts":[],"availableTokens":[]}}}],"Videos":[],"estimatedDateArrival":"2017-02-20T00:00:00Z"}]},{"productId":"174540","productName":"Dipirona AspDip 1g 10 Comprimidos","brand":"Aspirina","brandId":16899,"brandImageUrl":null,"linkText":"aspdip-1g-10-comprimidos","productReference":"80965","productReferenceCode":"80965","categoryId":"108","productTitle":"Aspdip 1g 10 Comprimidos","metaTagDescription":"Aspdip 1g alivia dores e febre com ação rápida da dipirona. Indicado para adultos e adolescentes. Consulte seu médico e compre na Pague Menos!","releaseDate":"2025-10-09T00:00:00Z","clusterHighlights":{},"productClusters":{"200":"Todos","1000":"XML de Todo o Site","2603":"Farmacinha em Oferta","2814":"Bayer Ofertas","3150":"Medicamentos CMS","3394":"Produtos que você precisa ter em casa","3744":"Todos os Produtos - Menos GLP1","4110":"[TODOS CC1 = 5X MIN=40, CC2 = 10X MIN=40, CC6 = 6X MIN=40]"},"searchableClusters":{},"categories":["/Medicamentos e Saúde/Dor, Febre e inflamação/","/Medicamentos e Saúde/"],"categoriesIds":["/100/108/","/100/"],"link":"https://www.paguemenos.com.br/aspdip-1g-10-comprimidos/p","Medicamento":["True"],"MarcaPropria":["Não"],"NumeroRegistroMS":["1705601310234"],"Ame":["Não"],"ApresentarPrecoDePor":["Sim"],"custom_label_0":["campanha"],"Cashback":["Não"],"Campos de Produto":["Medicamento","MarcaPropria","NumeroRegistroMS","Ame","ApresentarPrecoDePor","custom_label_0","Cashback"],"allSpecifications":["Medicamento","MarcaPropria","NumeroRegistroMS","Ame","ApresentarPrecoDePor","custom_label_0","Cashback"],"allSpecificationsGroups":["Campos de Produto"],"description":"<h2>O que é Aspdip 1g 10 comprimidos?</h2><p><strong>Aspdip 1g 10 comprimidos</strong> é um medicamento à base de <strong>dipirona monoidratada</strong>, indicado para o <strong>alívio da dor e da febre</strong>. Atua como analgésico e antipirético, proporcionando conforto em casos de dores de cabeça, dores musculares, cólicas, dores dentárias ou estados febris. Seu uso é indicado para <strong>adultos e adolescentes acima de 15 anos</strong>, sempre conforme orientação médica.</p><p><strong>Conteúdo da embalagem:</strong> 10 comprimidos</p><p><strong>Fabricado por:</strong> <a href=\"/bayer\">Bayer</a></p><p><strong>Indicação etária:</strong> Uso adulto e adolescentes acima de 15 anos</p><h2>Composição Aspdip 1g:</h2><p><strong>Princípio ativo:</strong> <a href=\"/dipirona\">Dipirona monoidratada</a> 1g</p><p><strong>Excipientes:</strong> celulose microcristalina, amido, povidona, estearato de magnésio, entre outros componentes inativos.</p><h2>Para que serve Aspdip?</h2><ul><li><strong>Alívio de dores leves a moderadas</strong>, como dor de cabeça, dor muscular, cólica e dor dentária</li><li><strong>Redução da febre</strong> associada a gripes e resfriados</li><li>Pode ser utilizado como <strong>analgésico e antipirético de ação rápida</strong></li></ul><h2>Como devo tomar Aspdip 1g?</h2><ul><li><strong>Adultos e adolescentes acima de 15 anos:</strong> ingerir ½ a 1 comprimido até 4 vezes ao dia, conforme necessidade</li><li>Tomar com um copo de água, de preferência após as refeições</li><li>O uso deve ser feito <strong>apenas pelo tempo indicado pelo médico</strong></li><li>Não exceder a dose recomendada</li></ul><h2>Quando não devo tomar Aspdip?</h2><ul><li>Em caso de <strong>alergia à dipirona</strong> ou a qualquer componente da fórmula</li><li>Se houver histórico de <strong>reações alérgicas graves</strong> (como urticária, broncoespasmo ou choque anafilático) a medicamentos para dor, como paracetamol, ibuprofeno ou diclofenaco</li><li><strong>Doenças hematológicas</strong> ou função da medula óssea prejudicada</li><li><strong>Porfiria hepática aguda intermitente</strong> ou <strong>deficiência de G6PD</strong></li><li>Durante a <strong>gravidez e amamentação</strong></li><li>O medicamento não deve ser utilizado em <strong>crianças menores de 15 anos</strong></li></ul>","items":[{"itemId":"179849","name":"Dipirona AspDip 1g 10 Comprimidos","nameComplete":"Dipirona AspDip 1g 10 Comprimidos","complementName":"","ean":"7891106916653","referenceId":[{"Key":"RefId","Value":"80965"}],"measurementUnit":"un","unitMultiplier":1.0000,"modalType":null,"isKit":false,"images":[{"imageId":"1157800","imageLabel":"","imageTag":"<img src=\"~/arquivos/ids/1157800-#width#-#height#/7891106916653-Dipirona_AspDip_1g_10_Comprimidos-Analg_sico-Aspirina--1-.jpg?v=639105034004730000\" width=\"#width#\" height=\"#height#\" alt=\"7891106916653-Dipirona_AspDip_1g_10_Comprimidos-Analg_sico-Aspirina--1-\" id=\"\" />","imageUrl":"https://paguemenos.vteximg.com.br/arquivos/ids/1157800/7891106916653-Dipirona_AspDip_1g_10_Comprimidos-Analg_sico-Aspirina--1-.jpg?v=639105034004730000","imageText":"7891106916653-Dipirona_AspDip_1g_10_Comprimidos-Analg_sico-Aspirina--1-","imageLastModified":"2026-03-30T21:36:40.4730000Z"},{"imageId":"1157801","imageLabel":"","imageTag":"<img src=\"~/arquivos/ids/1157801-#width#-#height#/7891106916653-Dipirona_AspDip_1g_10_Comprim