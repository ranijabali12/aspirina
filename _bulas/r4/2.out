omain":["10 day","15 day","30 day","60 day","90 day"]}},"composition":null}]}]}},{"productId":"900672","productName":"Analgésico Aspdip Dipirona 1g 10 Comprimidos","brand":"Bayer","brandId":90445,"brandImageUrl":null,"linkText":"analgesico-aspdip-1g-10-comprimidos","productReference":"900672","productReferenceCode":"900672","categoryId":"868","productTitle":"Analgésico Aspdip 1g 10 Comprimidos","metaTagDescription":"Compra Analgésico Aspdip 1g 10 Comprimidos na Drogaria Pacheco | Entrega Rápida e Segura | Parcele em até 3 vezes sem Juros!","releaseDate":"2025-10-01T07:00:00Z","clusterHighlights":{},"productClusters":{"4422":"tudo-menos-medicamentos-2020","4437":"todos-medicamentos","6059":"Cupom Progressivo","6406":"Vitrine Johnson & Johnson - 16/03","24208":"Campanha OTC"},"searchableClusters":{},"categories":["/Remédios/"],"categoriesIds":["/868/"],"link":"https://www.drogariaspacheco.com.br/analgesico-aspdip-1g-10-comprimidos/p","Princípio Ativo":["Com Dipirona"],"Forma de Administração":["Via Oral"],"Doenças & Complicações":["Para Dor","Para Febre"],"Partes do Corpo":["Para O Corpo"],"Classe dos Remédios":["Analgésicos","Antitérmicos"],"Tipo de Medicamento":["De Outros Tipos"],"Especificações":["Princípio Ativo","Forma de Administração","Doenças & Complicações","Partes do Corpo","Classe dos Remédios","Tipo de Medicamento"],"allSpecifications":["Princípio Ativo","Forma de Administração","Doenças & Complicações","Partes do Corpo","Classe dos Remédios","Tipo de Medicamento"],"allSpecificationsGroups":["Especificações"],"description":"Aspdip 1g comprimidos – analgésico e antitérmico à base de dipirona<br/> <br/> O Aspdip 1g é um medicamento analgésico e antitérmico à base de dipirona monoidratada, indicado para o alívio de dores de intensidade moderada a intensa e para a redução da febre em adultos e adolescentes a partir de 15 anos. Produzido pela Bayer S.A., combina eficácia comprovada com uma formulação de uso oral prática e acessível.<br/> <br/> Para que serve<br/> <br/> O Aspdip 1g comprimido é indicado para:<br/> Dor de cabeça e enxaqueca leve a moderada<br/> Dores musculares e articulares<br/> Cólica menstrual e outros tipos de cólica visceral<br/> Dor de dente<br/> Estados febris de diferentes origens<br/> <br/> <br/> Como funciona<br/> <br/> O princípio ativo dipirona monoidratada atua sobre o sistema nervoso central e periférico, inibindo os mecanismos de percepção da dor e auxiliando na regulação da temperatura corporal. O início do efeito analgésico e antitérmico ocorre geralmente entre 30 e 60 minutos após a administração oral, com duração média de aproximadamente 4 horas.<br/> <br/> Modo de uso<br/> Administração por via oral, preferencialmente com água<br/> Dose recomendada: de meio comprimido a 1 comprimido por tomada<br/> Intervalo entre as doses: respeitar o tempo indicado na bula ou orientação médica<br/> Frequência máxima: até 4 vezes ao dia<br/> Siga rigorosamente as recomendações do médico ou as instruções contidas na bula<br/> <br/> <br/> Precauções<br/> <br/> O uso do Aspdip 1g requer atenção às seguintes contraindicações e advertências:<br/> Contraindicado para menores de 15 anos<br/> Contraindicado durante a gestação e o período de amamentação<br/> Não deve ser utilizado por pessoas com hipersensibilidade à dipirona, a derivados pirazolônicos ou a qualquer excipiente da formulação<br/> Histórico de reações alérgicas graves a analgésicos ou anti-inflamatórios representa contraindicação ao uso<br/> Informe ao médico ou farmacêutico sobre todos os medicamentos em uso antes de iniciar o tratamento<br/> <br/> <br/> Composição<br/> <br/> Cada comprimido de Aspdip 1g contém:<br/> Dipirona monoidratada: 1.000 mg (1g)<br/> Excipientes: consulte a bula para a relação completa<br/> <br/> <br/> Informações adicionais<br/> Fabricante: Bayer S.A.<br/> Apresentação: caixa com 10 comprimidos<br/> Concentração: 1g por comprimido<br/> Via de administração: oral<br/> Classificação de uso: adulto e adolescentes acima de 15 anos<br/> Categoria regulatória: isento de prescrição médica<br/> <br/> <br/> Este medicamento deve ser utilizado conforme orientação médica.<br/> Em caso de dúvidas, consulte o profissional de saúde.<br/> Leia atentamente a bula antes de iniciar o uso.<br/> SE PERSISTIREM OS SINTOMAS, O MÉDICO DEVERÁ SER CONSULTADO.","items":[{"itemId":"900672","name":"Analgésico Aspdip Dipirona 1g 10 Comprimidos","nameComplete":"Analgésico Aspdip Dipirona 1g 10 Comprimidos","complementName":"Analgésico Aspdip Dipirona 1g 10 Comprimidos","ean":"7891106916653","referenceId":[{"Key":"RefId","Value":"900672"}],"measurementUnit":"un","unitMultiplier":1.0000,"modalType":"GLASS","isKit":false,"images":[{"imageId":"2330565","imageLabel":"","imageTag":"<img src=\"~/arquivos/ids/2330565-#width#-#height#/900672---Analgesico-Aspdip-1g-10-Comprimidos.jpg?v=639102260579570000\" width=\"#width#\" height=\"#height#\" alt=\"900672---Analgesico-Aspdip-1g-10-Comprimidos\" id=\"\" />","imageUrl":"https://drogariaspacheco.vteximg.com.br/arquivos/ids/2330565/900672---Analgesico-Aspdip-1g-10-Comprimidos.jpg?v=639102260579570000","imageText":"900672---Analgesico-Aspdip-1g-10-Comprimidos","imageLastModified":"2026-03-27T16:34:17.9570000Z"},{"imageId":"2330566","imageLabel":"","imageTag":"<img src=\"~/arquivos/ids/2330566-#width#-#height#/900672---Analgesico-Aspdip-1g-10-Comprimidos-2.jpg?v=639102260579870000\" width=\"#width#\" height=\"#height#\" alt=\"900672---Analgesico-Aspdip-1g-10-Comprimidos-2\" id=\"\" />","imageUrl":"https://drogariaspacheco.vteximg.com.br/arquivos/ids/2330566/900672---Analgesico-Aspdip-1g-10-Comprimidos-2.jpg?v=639102260579870000","imageText":"900672---Analgesico-Aspdip-1g-10-Comprimidos-2","imageLastModified":"2026-03-27T16:34:17.9870000Z"},{"imageId":"2330567","imageLabel":"","imageTag":"<img src=\"~/arquivos/ids/2330567-#width#-#height#/_900672---Analgesico-Aspdip-1g-10-Comprimidos-3.jpg?v=639102260580170000\" width=\"#width#\" height=\"#height#\" alt=\"_900672---Analgesico-Aspdip-1g-10-Comprimidos-3\" id=\"\" />","imageUrl":"https://drogariaspacheco.vteximg.com.br/arquivos/ids/2330567/_900672---Analgesico-Aspdip-1g-10-Comprimidos-3.jpg?v=639102260580170000","imageText":"_900672---Analgesico-Aspdip-1g-10-Comprimidos-3","imageLastModified":"2026-03-27T16:34:18.0170000Z"},{"imageId":"2330568","imageLabel":"","imageTag":"<img src=\"~/arquivos/ids/2330568-#width#-#height#/900672---Analgesico-Aspdip-1g-10-Comprimidos-4.jpg?v=639102260580170000\" width=\"#width#\" height=\"#height#\" alt=\"900672---Analgesico-Aspdip-1g-10-Comprimidos-4\" id=\"\" />","imageUrl":"https://drogariaspacheco.vteximg.com.br/arquivos/ids/2330568/900672---Analgesico-Aspdip-1g-10-Comprimidos-4.jpg?v=639102260580170000","imageText":"900672---Analgesico-Aspdip-1g-10-Comprimidos-4","imageLastModified":"2026-03-27T16:34:18.0170000Z"}],"attachments":[{"id":13,"name":"vtex.subscription.assinatura","required":false,"domainValues":"[{\"FieldName\":\"vtex.subscription.key.frequency\",\"MaxCaracters\":\"\",\"DomainValues\":\"10 day,15 day,30 day,60 day,90 day\"}]"}],"sellers":[{"sellerId":"1","sellerName":"Drogarias Pacheco","addToCartLink":"https://www.drogariaspacheco.com.br/checkout/cart/add?sku=900672&qty=1&seller=1&sc=1&price=990&cv=_&sc=1","sellerDefault":true,"commertialOffer":{"DeliverySlaSamplesPerRegion":{"0":{"DeliverySlaPerTypes":[],"Region":null}},"Installments":[{"Value":9.9,"InterestRate":0.0,"TotalValuePlusInterestRate":9.9,"NumberOfInstallments":1,"PaymentSystemName":"American Express","PaymentSystemGroupName":"creditCardPaymentGroup","Name":"American Express à vista"},{"Value":9.9,"InterestRate":0.0,"TotalValuePlusInterestRate":9.9,"NumberOfInstallments":1,"PaymentSystemName":"Visa","PaymentSystemGroupName":"creditCardPaymentGroup","Name":"Visa à vista"},{"Value":9.9,"InterestRate":0.0,"TotalValuePlusInterestRate":9.9,"NumberOfInstallments":1,"PaymentSystemName":"Diners","PaymentSystemGroupName":"creditCardPaymentGroup","Name":"Diners à vista"},{"Value":9.9,"