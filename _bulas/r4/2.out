ull,"requiresAuthentication":false,"dueDate":"2026-10-20T17:30:30.521076Z","availablePayments":null},{"id":45,"name":"Venda Direta Credito","groupName":"creditDirectSalePaymentGroup","validator":null,"stringId":"45","template":"creditDirectSalePaymentGroup-template","requiresDocument":false,"isCustom":false,"description":null,"requiresAuthentication":false,"dueDate":"2026-10-20T17:30:30.5210763Z","availablePayments":null},{"id":201,"name":"Dinheiro","groupName":"custom201PaymentGroupPaymentGroup","validator":null,"stringId":"201","template":"custom201PaymentGroupPaymentGroup-template","requiresDocument":false,"isCustom":true,"description":"Dinheiro","requiresAuthentication":true,"dueDate":"2026-10-20T17:32:30.5210767Z","availablePayments":null},{"id":900,"name":"WH Google Pay","groupName":"WH Google PayPaymentGroup","validator":null,"stringId":"900","template":"WH Google PayPaymentGroup-template","requiresDocument":false,"isCustom":false,"description":null,"requiresAuthentication":false,"dueDate":"2026-10-20T17:30:30.5210768Z","availablePayments":null}],"payments":[],"giftCards":[],"giftCardMessages":[],"availableAccounts":[],"availableTokens":[]}}}],"Videos":[],"estimatedDateArrival":null}],"itemMetadata":{"items":[{"Name":"Analgésico Aspdip Dipirona 1g 10 Comprimidos","NameComplete":"Analgésico Aspdip Dipirona 1g 10 Comprimidos","MainImage":"https://drogariaspacheco.vteximg.com.br/arquivos/ids/2330565/900672---Analgesico-Aspdip-1g-10-Comprimidos.jpg","BrandName":"Bayer","CategoryId":868,"ProductId":900672,"id":"900672","seller":"1","assemblyOptions":[{"id":"vtex.subscription.assinatura","name":"vtex.subscription.assinatura","required":false,"inputValues":{"vtex.subscription.key.frequency":{"maximumNumberOfCharacters":6,"domain":["10 day","15 day","30 day","60 day","90 day"]}},"composition":null}]}]}},{"productId":"900702","productName":"Analgésico Aspdip Dipirona 500mg 20ml Gotas","brand":"Bayer","brandId":90445,"brandImageUrl":null,"linkText":"analgesico-aspdip-500mg-20ml-gotas","productReference":"900702","productReferenceCode":"900702","categoryId":"868","productTitle":"Analgésico Aspdip 500mg 20ml Gotas","metaTagDescription":"Compra Analgésico Aspdip 500mg 20ml Gotas na Drogaria Pacheco | Entrega Rápida e Segura | Parcele em até 3 vezes sem Juros!","releaseDate":"2025-10-01T07:00:00Z","clusterHighlights":{},"productClusters":{"4422":"tudo-menos-medicamentos-2020","4437":"todos-medicamentos","6059":"Cupom Progressivo","6406":"Vitrine Johnson & Johnson - 16/03","24070":"Campanha Feriadão","24089":"Campanha Imperdíveis","24208":"Campanha OTC","24487":"Campanha 72 horas","24489":"Campanha Leve Mais Por Menos"},"searchableClusters":{},"categories":["/Remédios/"],"categoriesIds":["/868/"],"link":"https://www.drogariaspacheco.com.br/analgesico-aspdip-500mg-20ml-gotas/p","Princípio Ativo":["Com Dipirona"],"Forma de Administração":["Via Oral"],"Doenças & Complicações":["Para Dor","Para Febre"],"Partes do Corpo":["Para O Corpo"],"Classe dos Remédios":["Analgésicos","Antitérmicos"],"Tipo de Medicamento":["De Outros Tipos"],"Especificações":["Princípio Ativo","Forma de Administração","Doenças & Complicações","Partes do Corpo","Classe dos Remédios","Tipo de Medicamento"],"allSpecifications":["Princípio Ativo","Forma de Administração","Doenças & Complicações","Partes do Corpo","Classe dos Remédios","Tipo de Medicamento"],"allSpecificationsGroups":["Especificações"],"description":"Aspdip gotas 500mg/mL – 20mL<br/> <br/> Aspdip gotas é um medicamento analgésico e antitérmico desenvolvido pela Bayer S.A., formulado com dipirona monoidratada 500mg/mL. Apresentado em frasco gotejador de 20mL, é indicado para o tratamento sintomático de dores de diferentes origens e para a redução da febre em adultos e crianças a partir de 3 meses de idade.<br/> <br/> Para que serve<br/> <br/> Aspdip gotas é indicado para o alívio sintomático de:<br/> Dor de cabeça<br/> Dores musculares<br/> Cólicas (menstrual, renal e biliar)<br/> Febre de diferentes etiologias<br/> Dor de dente<br/> Dores pós-operatórias e pós-procedimentos<br/> <br/> <br/> Pode ser utilizado por adultos, adolescentes e crianças com peso superior a 5kg e idade acima de 3 meses.<br/> <br/> Como funciona<br/> <br/> O princípio ativo dipirona monoidratada atua inibindo a síntese de prostaglandinas, substâncias envolvidas na percepção da dor e na elevação da temperatura corporal. O início do efeito ocorre entre 30 e 60 minutos após a administração, com duração de aproximadamente 4 horas.<br/> <br/> Modo de uso<br/> <br/> A posologia deve ser individualizada conforme a faixa etária e o peso do paciente:<br/> Adultos e adolescentes acima de 15 anos: 20 a 40 gotas por dose, podendo ser repetida até 4 vezes ao dia<br/> Crianças: dose calculada com base no peso corporal, conforme orientação médica<br/> <br/> <br/> Referência de medida: cada mL equivale a 20 gotas; cada gota contém 25mg de dipirona.<br/> <br/> Respeite o intervalo mínimo de 4 a 6 horas entre as administrações e não ultrapasse 4 doses diárias.<br/> <br/> Precauções<br/> <br/> Observe as seguintes contraindicações e cuidados antes do uso:<br/> Contraindicado para crianças com menos de 3 meses de idade ou peso inferior a 5kg<br/> Não recomendado durante a gestação, especialmente no primeiro e no terceiro trimestre<br/> Contraindicado durante o período de lactação<br/> Não deve ser utilizado por pacientes com hipersensibilidade conhecida à dipirona ou a outros analgésicos não opioides<br/> Use com cautela em pacientes com comprometimento hepático ou renal<br/> Não indicado para pacientes com hipotensão arterial ou instabilidade hemodinâmica<br/> <br/> <br/> Composição<br/> <br/> Cada mL de Aspdip gotas contém:<br/> Dipirona monoidratada: 500mg<br/> <br/> <br/> Para informações completas sobre excipientes e demais componentes da formulação, consulte a bula do produto.<br/> <br/> Informações adicionais<br/> Fabricante: Bayer S.A.<br/> Forma farmacêutica: solução oral em gotas<br/> Volume: 20mL<br/> Via de administração: oral<br/> Classificação: isento de prescrição médica<br/> Faixa etária: uso adulto e pediátrico (a partir de 3 meses e peso acima de 5kg)<br/> <br/> <br/> Armazene em temperatura ambiente, protegido da luz e da umidade. Mantenha fora do alcance de crianças.<br/> <br/> Este medicamento deve ser utilizado conforme orientação médica.<br/> Em caso de dúvidas, consulte o profissional de saúde.<br/> Leia atentamente a bula antes de iniciar o uso.<br/> SE PERSISTIREM OS SINTOMAS, O MÉDICO DEVERÁ SER CONSULTADO.","items":[{"itemId":"900702","name":"Analgésico Aspdip Dipirona 500mg 20ml Gotas","nameComplete":"Analgésico Aspdip Dipirona 500mg 20ml Gotas","complementName":"Analgésico Aspdip Dipirona 500mg 20ml Gotas","ean":"7891106916684","referenceId":[{"Key":"RefId","Value":"900702"}],"measurementUnit":"un","unitMultiplier":1.0000,"modalType":"GLASS","isKit":false,"images":[{"imageId":"1576325","imageLabel":"","imageTag":"<img src=\"~/arquivos/ids/1576325-#width#-#height#/900702---Analgesico-Aspdip-500mg-20ml-Gotas-1.jpg?v=638959631528200000\" width=\"#width#\" height=\"#height#\" alt=\"900702---Analgesico-Aspdip-500mg-20ml-Gotas-1\" id=\"\" />","imageUrl":"https://drogariaspacheco.vteximg.com.br/arquivos/ids/1576325/900702---Analgesico-Aspdip-500mg-20ml-Gotas-1.jpg?v=638959631528200000","imageText":"900702---Analgesico-Aspdip-500mg-20ml-Gotas-1","imageLastModified":"2025-10-13T14:39:12.8200000Z"},{"imageId":"1576326","imageLabel":"","imageTag":"<img src=\"~/arquivos/ids/1576326-#width#-#height#/900702---ASPDIP-500MG-20ML-BAYER-2.jpg?v=638959631528330000\" width=\"#width#\" height=\"#height#\" alt=\"900702---ASPDIP-500MG-20ML-BAYER-2\" id=\"\" />","imageUrl":"https://drogariaspacheco.vteximg.com.br/arquivos/ids/1576326/900702---ASPDIP-500MG-20ML-BAYER-2.jpg?v=638959631528330000","imageText":"900702---ASPDIP-500MG-20ML-BAYER-2","imageLastModified":"2025-10-13T14:39:12.8330000Z"},{"imageId":"1576327","imageLabel":"","imageTag":"<img src=\"~/arquivos/ids/