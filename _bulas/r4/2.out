[{"productId":"900680","productName":"Analgésico Aspdip Dipirona 500mg 30 Comprimidos","brand":"Bayer","brandId":90445,"brandImageUrl":null,"linkText":"analgesico-aspdip-500mg-30-comprimidos","productReference":"900680","productReferenceCode":"900680","categoryId":"868","productTitle":"Analgésico Aspdip 500mg 30 Comprimidos","metaTagDescription":"Compra Analgésico Aspdip 500mg 30 Comprimidos na Drogaria Pacheco | Entrega Rápida e Segura | Parcele em até 3 vezes sem Juros!","releaseDate":"2025-10-01T07:00:00Z","clusterHighlights":{},"productClusters":{"4422":"tudo-menos-medicamentos-2020","4437":"todos-medicamentos","6059":"Cupom Progressivo","6406":"Vitrine Johnson & Johnson - 16/03","24070":"Campanha Feriadão","24208":"Campanha OTC","24487":"Campanha 72 horas","24489":"Campanha Leve Mais Por Menos"},"searchableClusters":{},"categories":["/Remédios/"],"categoriesIds":["/868/"],"link":"https://www.drogariaspacheco.com.br/analgesico-aspdip-500mg-30-comprimidos/p","Princípio Ativo":["Com Dipirona"],"Forma de Administração":["Via Oral"],"Doenças & Complicações":["Para Dor","Para Febre"],"Partes do Corpo":["Para O Corpo"],"Classe dos Remédios":["Analgésicos","Antitérmicos"],"Tipo de Medicamento":["De Outros Tipos"],"Especificações":["Princípio Ativo","Forma de Administração","Doenças & Complicações","Partes do Corpo","Classe dos Remédios","Tipo de Medicamento"],"allSpecifications":["Princípio Ativo","Forma de Administração","Doenças & Complicações","Partes do Corpo","Classe dos Remédios","Tipo de Medicamento"],"allSpecificationsGroups":["Especificações"],"description":"Aspdip Bayer 500mg – 30 Comprimidos<br/> <br/> Aspdip é um medicamento analgésico e antitérmico com dipirona monoidratada 500mg por comprimido, fabricado pela Bayer S.A. Indicado para adultos e adolescentes a partir de 15 anos, atua no alívio de dores moderadas a intensas e na redução da febre, com início de ação entre 30 e 60 minutos após a administração oral.<br/> <br/> Para que serve<br/> <br/> Aspdip 500mg é indicado nos seguintes casos:<br/> Dor de cabeça e cefaleia tensional<br/> Dores musculares e articulares leves a moderadas<br/> Cólicas menstruais e abdominais<br/> Estados febris de diferentes etiologias<br/> Dores de intensidade moderada a intensa que necessitem de analgesia<br/> <br/> <br/> Como funciona<br/> <br/> O princípio ativo dipirona monoidratada age sobre o sistema nervoso central e periférico, inibindo a síntese de prostaglandinas, substâncias envolvidas na percepção da dor e na elevação da temperatura corporal. A duração do efeito é de aproximadamente 4 horas por dose administrada.<br/> <br/> Modo de uso<br/> Administração por via oral, com ingestão de água<br/> Dose recomendada: 1 a 2 comprimidos por tomada<br/> Respeitar o intervalo mínimo de 6 horas entre as doses<br/> Não exceder 4 tomadas ao dia<br/> Utilize sempre sob orientação médica ou farmacêutica<br/> <br/> <br/> Precauções<br/> Contraindicado para pacientes menores de 15 anos<br/> Contraindicado durante a gestação e a lactação<br/> Não utilizar em casos de hipersensibilidade à dipirona ou a derivados pirazolônicos<br/> Informe ao médico sobre todos os medicamentos em uso concomitante<br/> Não ultrapassar a dose diária recomendada<br/> Em caso de febre persistente por mais de 3 dias ou dor por mais de 5 dias sem melhora, procure avaliação médica<br/> <br/> <br/> Composição<br/> <br/> Cada comprimido contém:<br/> Dipirona monoidratada: 500mg<br/> Excipientes: conforme descrição completa na bula<br/> <br/> <br/> Informações adicionais<br/> Fabricante: Bayer S.A.<br/> Apresentação: caixa com 30 comprimidos<br/> Forma farmacêutica: comprimido de uso oral<br/> Classificação terapêutica: analgésico e antitérmico<br/> Dispensação: isento de prescrição médica<br/> Faixa de uso: adultos e adolescentes a partir de 15 anos<br/> <br/> <br/> Este medicamento deve ser utilizado conforme orientação médica.<br/> Em caso de dúvidas, consulte o profissional de saúde.<br/> Leia atentamente a bula antes de iniciar o uso.<br/> SE PERSISTIREM OS SINTOMAS, O MÉDICO DEVERÁ SER CONSULTADO.","items":[{"itemId":"900680","name":"Analgésico Aspdip Dipirona 500mg 30 Comprimidos","nameComplete":"Analgésico Aspdip Dipirona 500mg 30 Comprimidos","complementName":"Analgésico Aspdip Dipirona 500mg 30 Comprimidos","ean":"7891106916660","referenceId":[{"Key":"RefId","Value":"900680"}],"measurementUnit":"un","unitMultiplier":1.0000,"modalType":"GLASS","isKit":false,"images":[{"imageId":"1556956","imageLabel":"","imageTag":"<img src=\"~/arquivos/ids/1556956-#width#-#height#/900680---Analgesico-Aspdip-500mg-30-Comprimidos-1.jpg?v=638956138558270000\" width=\"#width#\" height=\"#height#\" alt=\"900680---Analgesico-Aspdip-500mg-30-Comprimidos-1\" id=\"\" />","imageUrl":"https://drogariaspacheco.vteximg.com.br/arquivos/ids/1556956/900680---Analgesico-Aspdip-500mg-30-Comprimidos-1.jpg?v=638956138558270000","imageText":"900680---Analgesico-Aspdip-500mg-30-Comprimidos-1","imageLastModified":"2025-10-09T13:37:35.8270000Z"},{"imageId":"1576321","imageLabel":"","imageTag":"<img src=\"~/arquivos/ids/1576321-#width#-#height#/900680---ASPDIP-500MG-30CP-BAYER-2.jpg?v=638959630858300000\" width=\"#width#\" height=\"#height#\" alt=\"900680---ASPDIP-500MG-30CP-BAYER-2\" id=\"\" />","imageUrl":"https://drogariaspacheco.vteximg.com.br/arquivos/ids/1576321/900680---ASPDIP-500MG-30CP-BAYER-2.jpg?v=638959630858300000","imageText":"900680---ASPDIP-500MG-30CP-BAYER-2","imageLastModified":"2025-10-13T14:38:05.8300000Z"},{"imageId":"1576322","imageLabel":"","imageTag":"<img src=\"~/arquivos/ids/1576322-#width#-#height#/900680---ASPDIP-500MG-30CP-BAYER-3.jpg?v=638959630858300000\" width=\"#width#\" height=\"#height#\" alt=\"900680---ASPDIP-500MG-30CP-BAYER-3\" id=\"\" />","imageUrl":"https://drogariaspacheco.vteximg.com.br/arquivos/ids/1576322/900680---ASPDIP-500MG-30CP-BAYER-3.jpg?v=638959630858300000","imageText":"900680---ASPDIP-500MG-30CP-BAYER-3","imageLastModified":"2025-10-13T14:38:05.8300000Z"},{"imag