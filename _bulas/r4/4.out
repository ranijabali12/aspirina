[{"productId":"900680","productName":"Analgésico Aspdip Dipirona 500mg 30 Comprimidos","brand":"Bayer","brandId":90445,"brandImageUrl":"https://drogariasp.vteximg.com.br/arquivos/ids/184139/bayer.jpg","linkText":"analgesico-aspdip-500mg-30-comprimidos","productReference":"900680","productReferenceCode":"900680","categoryId":"868","productTitle":"Analgésico Aspdip 500mg 30 Comprimidos","metaTagDescription":"Compra Analgésico Aspdip 500mg 30 Comprimidos na Drogaria São Paulo | Entrega Rápida e Segura | Parcele em até 3 vezes sem Juros!","releaseDate":"2025-10-01T07:00:00Z","clusterHighlights":{},"productClusters":{"143":"todos-os-itens","4731":"todos-itens-admatic","4825":"MEMED PREVENT SENIOR","4851":"MEMED PREVENT SENIOR","7287":"Cupom Progressivo","7657":"Vitrine Johnson & Johnson - 16/03","25631":"Campanha Feriadão","25767":"Campanha OTC","26048":"Campanha 72 horas","26050":"Campanha Leve Mais Por Menos"},"searchableClusters":{},"categories":["/Remédios/"],"categoriesIds":["/868/"],"link":"https://www.drogariasaopaulo.com.br/analgesico-aspdip-500mg-30-comprimidos/p","Princípio Ativo":["Com Dipirona"],"Forma de Administração":["Via Oral"],"Doenças & Complicações":["Para Dor","Para Febre"],"Partes do Corpo":["Para O Corpo"],"Classe dos Remédios":["Analgésicos","Antitérmicos"],"Tipo de Medicamento":["De Outros Tipos"],"Especificações":["Princípio Ativo","Forma de Administração","Doenças & Complicações","Partes do Corpo","Classe dos Remédios","Tipo de Medicamento"],"allSpecifications":["Princípio Ativo","Forma de Administração","Doenças & Complicações","Partes do Corpo","Classe dos Remédios","Tipo de Medicamento"],"allSpecificationsGroups":["Especificações"],"description":"Aspdip Bayer 500mg – 30 Comprimidos<br/> <br/> Aspdip é um analgésico e antitérmico à base de dipirona monoidratada 500mg, desenvolvido pela Bayer, uma das marcas farmacêuticas mais reconhecidas do mundo. Indicado para adultos e adolescentes a partir de 15 anos, é uma opção prática para quem precisa de alívio de dores moderadas a intensas e controle da febre no dia a dia.<br/> <br/> Para que serve<br/> <br/> Aspdip 500mg é indicado para o alívio de:<br/> Dor de cabeça e enxaqueca leve a moderada<br/> Dores musculares<br/> Cólicas menstruais e abdominais<br/> Febre de diferentes origens<br/> Dores de intensidade moderada a intensa<br/> <br/> <br/> Como funciona<br/> <br/> A dipirona monoidratada, princípio ativo do Aspdip, atua inibindo a produção de substâncias responsáveis pela dor e pelo aumento da temperatura corporal. O efeito começa a ser percebido entre 30 e 60 minutos após a ingestão e pode durar cerca de 4 horas, oferecendo alívio por um período confortável para quem está no trabalho, em casa ou em qualquer rotina.<br/> <br/> Modo de uso<br/> Via oral, com água<br/> Dose habitual: 1 a 2 comprimidos por tomada<br/> Intervalo de pelo menos 6 horas entre as doses<br/> Máximo de 4 tomadas ao dia<br/> Use sempre conforme orientação médica ou farmacêutica<br/> <br/> <br/> Precauções<br/> Contraindicado para menores de 15 anos<br/> Não indicado para gestantes e mulheres em período de amamentação<br/> Não use em caso de alergia à dipirona ou a outros derivados pirazolônicos<br/> Informe ao médico sobre outros medicamentos em uso, pois pode haver interações<br/> Não exceda a dose recomendada<br/> Em caso de febre persistente por mais de 3 dias ou dor por mais de 5 dias, procure orientação médica<br/> <br/> <br/> Composição<br/> <br/> Cada comprimido contém:<br/> Dipirona monoidratada: 500mg<br/> Excipientes: conforme bula do produto<br/> <br/> <br/> Informações adicionais<br/> Fabricante: Bayer S.A.<br/> Apresentação: caixa com 30 comprimidos<br/> Forma farmacêutica: comprimido de uso oral<br/> Classificação: analgésico e antitérmico isento de prescrição médica<br/> Uso: adulto e adolescentes a partir de 15 anos<br/> <br/> <br/> Este medicamento deve ser utilizado conforme orientação médica.<br/> Em caso de dúvidas, consulte o profissional de saúde.<br/> Leia atentamente a bula antes de iniciar o uso.<br/> SE PERSISTIREM OS SINTOMAS, O MÉDICO DEVERÁ SER CONSULTADO.","items":[{"itemId":"900680","name":"Analgésico Aspdip Dipirona 500mg 30 Comprimidos","nameComplete":"Analgésico Aspdip Dipirona 500mg 30 Comprimidos","complementName":"Analgésico Aspdip Dipirona 500mg 30 Comprimidos","ean":"7891106916660","referenceId":[{"Key":"RefId","Value":"900680"}],"measurementUnit":"un","unitMultiplier":1.0000,"modalType":"GLASS","isKit":false,"images":[{"imageId":"1410772","imageLabel":"","imageTag":"<img src=\"~/arquivos/ids/1410772-#width#-#height#/900680---Analgesico-Aspdip-500mg-30-Comprimidos-1.jpg?v=638956138498230000\" width=\"#width#\" height=\"#height#\" alt=\"900680---Analgesico-Aspdip-500mg-30-Comprimidos-1\" id=\"\" />","imageUrl":"https://drogariasp.vteximg.com.br/arquivos/ids/1410772/900680---Analgesico-Aspdip-500mg-30-Comprimidos-1.jpg?v=638956138498230000","imageText":"900680---Analgesico-Aspdip-500mg-30-Comprimidos-1","imageLastModified":"2025-10-09T13:37:29.8230000Z"},{"imageId":"1418790","imageLabel":"","imageTag":"<img src=\"~/arquivos/ids/1418790-#width#-#height#/900680---ASPDIP-500MG-30CP-BAYER-2.jpg?v=638959630752270000\" width=\"#width#\" height=\"#height#\" alt=\"900680---ASPDIP-500MG-30CP-BAYER-2\" id=\"\" />","imageUrl":"https://drogariasp.vteximg.com.br/arquivos/ids/1418790/900680---ASPDIP-500MG-30CP-BAYER-2.jpg?v=638959630752270000","imageText":"900680---ASPDIP-500MG-30CP-BAYER-2","imageLastModified":"2025-10-13T14:37:55.2270000Z"},{"imageId":"1418791","imageLabel":"","imageTag":"<img src=\"~/arquivos/ids/1418791-#width#-#height#/900680---ASPDIP-500MG-30CP-BAYER-3.jpg?v=638959630752400000\" width=\"#width#\" height=\"#height#\" alt=\"900680---ASPDIP-500MG-30CP-BAYER-3\" id=\"\" />","imageUrl":"https://drogariasp.vteximg.com.br/arquivos/ids/1418791/900680---ASPDIP-500MG-30CP-BAYER-3.jpg?v=638959630752400000","imageText":"900680---ASPDIP-500MG-30CP-BAYER-3","imageLastModified":"2025-10-13T14:37:55.2400000Z"},{