ion":null}]}]}},{"productId":"900672","productName":"Analgésico Aspdip Dipirona 1g 10 Comprimidos","brand":"Bayer","brandId":90445,"brandImageUrl":"https://drogariasp.vteximg.com.br/arquivos/ids/184139/bayer.jpg","linkText":"analgesico-aspdip-1g-10-comprimidos","productReference":"900672","productReferenceCode":"900672","categoryId":"868","productTitle":"Analgésico Aspdip 1g 10 Comprimidos","metaTagDescription":"Compra Analgésico Aspdip 1g 10 Comprimidos na Drogaria São Paulo | Entrega Rápida e Segura | Parcele em até 3 vezes sem Juros!","releaseDate":"2025-10-01T07:00:00Z","clusterHighlights":{},"productClusters":{"143":"todos-os-itens","4731":"todos-itens-admatic","4825":"MEMED PREVENT SENIOR","4851":"MEMED PREVENT SENIOR","7287":"Cupom Progressivo","7657":"Vitrine Johnson & Johnson - 16/03","25767":"Campanha OTC"},"searchableClusters":{},"categories":["/Remédios/"],"categoriesIds":["/868/"],"link":"https://www.drogariasaopaulo.com.br/analgesico-aspdip-1g-10-comprimidos/p","Princípio Ativo":["Com Dipirona"],"Forma de Administração":["Via Oral"],"Doenças & Complicações":["Para Dor","Para Febre"],"Partes do Corpo":["Para O Corpo"],"Classe dos Remédios":["Analgésicos","Antitérmicos"],"Tipo de Medicamento":["De Outros Tipos"],"Especificações":["Princípio Ativo","Forma de Administração","Doenças & Complicações","Partes do Corpo","Classe dos Remédios","Tipo de Medicamento"],"Valor Promocional":["12.68"],"Campos para Renderização de Informações Dinâmicas":["Valor Promocional"],"allSpecifications":["Princípio Ativo","Forma de Administração","Doenças & Complicações","Partes do Corpo","Classe dos Remédios","Tipo de Medicamento","Valor Promocional"],"allSpecificationsGroups":["Especificações","Campos para Renderização de Informações Dinâmicas"],"description":"Aspdip 1g comprimidos – dipirona para dor e febre<br/> <br/> Aquelas dores que aparecem do nada e atrapalham o seu dia merecem atenção. O Aspdip 1g é um analgésico e antitérmico à base de dipirona monoidratada, desenvolvido para ajudar no alívio de dores de intensidade moderada a intensa e na redução da febre em adultos e adolescentes a partir de 15 anos. Fabricado pela Bayer S.A., é um produto com tradição e qualidade reconhecidas.<br/> <br/> Para que serve<br/> <br/> O Aspdip 1g comprimido é indicado para o alívio de:<br/> Dor de cabeça, incluindo enxaqueca leve a moderada<br/> Dores musculares e corporais<br/> Cólica menstrual e outros tipos de cólica<br/> Dor de dente<br/> Febre de diversas origens<br/> <br/> <br/> Como funciona<br/> <br/> A dipirona monoidratada, princípio ativo do Aspdip 1g, age no sistema nervoso central e periférico, reduzindo a sensação de dor e auxiliando na normalização da temperatura corporal. O efeito costuma começar entre 30 e 60 minutos após a ingestão e pode durar cerca de 4 horas, proporcionando alívio por um período relevante do dia.<br/> <br/> Modo de uso<br/> Via oral, com auxílio de água<br/> Dose habitual: de meio comprimido a 1 comprimido inteiro<br/> Pode ser tomado até 4 vezes ao dia, respeitando o intervalo entre as doses<br/> Siga sempre a orientação do profissional de saúde ou as instruções da bula<br/> <br/> <br/> Precauções<br/> <br/> Antes de usar o Aspdip 1g, fique atento a algumas informações importantes:<br/> Contraindicado para crianças e adolescentes com menos de 15 anos<br/> Não deve ser usado por gestantes ou lactantes<br/> Contraindicado para pessoas com alergia à dipirona, a outros derivados pirazolônicos ou a qualquer componente da fórmula<br/> Não use em caso de histórico de reações graves a analgésicos ou anti-inflamatórios<br/> Em caso de dúvidas, converse com seu médico ou farmacêutico antes de iniciar o uso<br/> <br/> <br/> Composição<br/> <br/> Cada comprimido de Aspdip 1g contém:<br/> Dipirona monoidratada: 1.000 mg (1g)<br/> Excipientes: consulte a bula para a lista completa<br/> <br/> <br/> Informações adicionais<br/> Fabricante: Bayer S.A.<br/> Apresentação: caixa com 10 comprimidos<br/> Concentração: 1g por comprimido<br/> Via de administração: oral<br/> Uso: adulto e adolescentes acima de 15 anos<br/> Classificação: isento de prescrição médica<br/> <br/> <br/> Este medicamento deve ser utilizado conforme orientação médica.<br/> Em caso de dúvidas, consulte o profissional de saúde.<br/> Leia atentamente a bula antes de iniciar o uso.<br/> SE PERSISTIREM OS SINTOMAS, O MÉDICO DEVERÁ SER CONSULTADO.","items":[{"itemId":"900672","name":"Analgésico Aspdip Dipirona 1g 10 Comprimidos","nameComplete":"Analgésico Aspdip Dipirona 1g 10 Comprimidos","complementName":"Analgésico Aspdip Dipirona 1g 10 Comprimidos","ean":"7891106916653","referenceId":[{"Key":"RefId","Value":"900672"}],"measurementUnit":"un","unitMultiplier":1.0000,"modalType":"GLASS","isKit":false,"images":[{"imageId":"1839880","imageLabel":"","imageTag":"<img src=\"~/arquivos/ids/1839880-#width#-#height#/900672---Analgesico-Aspdip-1g-10-Comprimidos.jpg?v=639102260390530000\" width=\"#width#\" height=\"#height#\" alt=\"900672---Analgesico-Aspdip-1g-10-Comprimidos\" id=\"\" />","imageUrl":"https://drogariasp.vteximg.com.br/arquivos/ids/1839880/900672---Analgesico-Aspdip-1g-10-Comprimidos.jpg?v=639102260390530000","imageText":"900672---Analgesico-Aspdip-1g-10-Comprimidos","imageLastModified":"2026-03-27T16:33:59.0530000Z"},{"imageId":"1839881","imageLabel":"","imageTag":"<img src=\"~/arquivos/ids/1839881-#width#-#height#/900672---Analgesico-Aspdip-1g-10-Comprimidos-2.jpg?v=639102260390870000\" width=\"#width#\" height=\"#height#\" alt=\"900672---Analgesico-Aspdip-1g-10-Comprimidos-2\" id=\"\" />","imageUrl":"https://drogariasp.vteximg.com.br/arquivos/ids/1839881/900672---Analgesico-Aspdip-1g-10-Comprimidos-2.jpg?v=639102260390870000","imageText":"900672---Analgesico-Aspdip-1g-10-Comprimidos-2","imageLastModified":"2026-03-27T16:33:59.0870000Z"},{"imageId":"1839882","imageLabel":"","imageTag":"<img src=\"~/arquivos/ids/1839882-#width#-#height#/_900672---Analgesico-Aspdip-1g-10-Comprimidos-3.jpg?v=639102260390870000\" width